# Copia este archivo a .env y completa los valores. No subas valores reales al repositorio.
# En Render estas variables se configuran en el dashboard del servicio.

NODE_ENV=
PORT=

# Base de datos (Neon / PostgreSQL)
DATABASE_URL=

# Autenticación
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de este backend (callback de Google OAuth)
# producción: https://api.mirufranco.com
BACKEND_URL=

# URL del frontend: enlaces de correo, redirecciones de OAuth y origen permitido en CORS
# producción: https://www.mirufranco.com
FRONTEND_URL=

# CORS (opcional): orígenes EXACTOS adicionales, separados por comas, que pueden llamar a la API
# desde un navegador (p. ej. un dominio de preview de Vercel, o el frontend en la red local para
# `npm run dev:mobile`). Nunca usar "*": se ignora. El dominio de producción ya está permitido en
# src/config/cors.config.ts.
CORS_ALLOWED_ORIGINS=

# Correo (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# SMS (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Recuperación de contraseña (minutos de vigencia del enlace; por defecto 10)
RESET_TOKEN_EXPIRY_MINUTES=

# Vinculación de la Skill de Alexa
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
ALEXA_REDIRECT_URIS=

# Datadog (APM)
DD_API_KEY=
DD_SITE=
DD_SERVICE=
DD_ENV=
DD_VERSION=

# Mercado Pago Checkout Pro (credenciales de prueba o de producción; nunca en el código)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (panel de Mercado Pago > Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=
# URL pública del webhook de ESTE backend (https://<este backend>/api/pagos-en-linea/mercadopago/webhook). En local,
# déjala vacía: el regreso a la confirmación y la verificación periódica (cada 10 min) consultan el pago a Mercado Pago.
# Nunca pongas aquí la URL de producción desde otro entorno.
MP_WEBHOOK_URL=
# Prefijo de la referencia de los pagos (external_reference): dev o prod. Así un aviso de otro entorno se rechaza aunque
# los ids de pedidos y citas coincidan. Sin ella: prod si NODE_ENV=production; dev en cualquier otro caso.
MP_ENTORNO=

# Apartados y pedidos en línea vencidos: solo se cancelan pedidos creados desde esta fecha.
# Formato: YYYY-MM-DD (cuenta desde las 00:00 de ese día en hora de México) o fecha ISO con zona, p. ej. 2026-10-05T00:00:00-06:00.
# Sin esta variable la regla no corre.
APARTADOS_DESDE=

# Anticipos de citas (RESPALDO): la fecha se configura en Admin > Configuración del sitio > Reglas; esta variable solo
# se usa si ahí no hay fecha. Con una fecha, al agendar en línea un servicio con anticipo se pide el anticipo y la
# barrida libera las citas creadas desde esa fecha que no lo pagaron a tiempo. Sin ninguna de las dos (o con una fecha
# inválida) no se pide anticipo y GET /servicios responde anticipoAplica: false.
# Formato: YYYY-MM-DD (desde las 00:00 de ese día en hora de México) o fecha ISO con zona.
ANTICIPOS_DESDE=

# Cloudinary: firma de la subida de la foto de perfil (POST /api/auth/me/foto/firma) y validación
# de la URL de la foto. Panel de Cloudinary > Settings > API Keys. El API secret nunca va en el cliente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
